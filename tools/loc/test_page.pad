# Pad script for the localization test page (tools/loc/test_page.sh).
# Main menu -> New Game -> slots -> Continue Without Saving -> Burrow, as
# tests/scripts/phase3_new_game.pad, then the pause menu and the inventory.
450 press A
520 press DOWN 4
540 press DOWN 4
560 press DOWN 4
600 press A
700 press A
6000 stick L 0 1 90
6150 stick L -1 0 30
6200 stick L 0 1 100
# Pause menu (title + panel fonts), resume with START.
6400 press START
6520 press START
# Inventory / folio screens (inventory title font).
6600 press BACK
6720 press BACK
6800 press Y
6920 press Y
